<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>Strands.Harness</PackageId>
    <Description>Composable harness defaults and local tools for native Strands .NET agents.</Description>
    <PackageTags>strands;harness;agents;ai</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <Compile Include="../../../strands-dotnet/CompilerTypeForwarders.cs" Link="CompilerTypeForwarders.cs" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.13" />
    <ProjectReference Include="../../../strands-dotnet/src/Strands.Agents/Strands.Agents.csproj" />
    <ProjectReference Include="../../../strands-dotnet/src/Strands.Agents.Bedrock/Strands.Agents.Bedrock.csproj" />
    <ProjectReference Include="../../../strands-dotnet/src/Strands.Agents.Monty/Strands.Agents.Monty.csproj" />
    <ProjectReference Include="../../../strands-dotnet/src/Strands.Agents.OpenTelemetry/Strands.Agents.OpenTelemetry.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE.APACHE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="../../../strands-dotnet/CompilerCompatibility.cs" Link="CompilerCompatibility.cs" />
  </ItemGroup>
</Project>
