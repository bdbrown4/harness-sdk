  "contracts": [
    "caller-owned HttpClient; response and stream disposal",
    "cached card discovery and authenticated extended-card replacement",
    "JSONRPC advertised interface selection and explicit URL override",
    "request ID correlation and raw wire field preservation",
    "bounded multiline SSE and incremental strict UTF-8 decoding",
    "artifact append/replacement and bounded retained bookkeeping",
    "tasks/get, tasks/cancel and tasks/resubscribe",
    "rich data/media/resource references; HTTP image URL and byte video",
    "explicit S3 and guard-content rejection; no URI auto-download",
    "Python task stop mapping and TypeScript text-only/end-turn options",
    "local-only caller invocation state",
    "input-required structured-answer continuation over real TCP HTTP",
    "primary failure identity with nested cleanup failures",
    "final status-message precedence matching pinned TS and Python; complete Task artifact precedence",
    "stream requests retain correlated immediate JSON-RPC errors returned as application/json; non-streamed JSON success remains invalid"
  ],
  "remaining": [
    "native executor/server/context ownership/task stores",
    "standalone and hosted server transports",
    "permitted-endpoint vended A2A client tool",
    "remote-agent graph node and durable remote interruption bridge",
    "gRPC and REST/HTTP+JSON transports",
    "push-delivery hosting and subscription lifecycle",
    "authenticated transport handlers are caller-provided; no credential service integration",
    "full foreign SDK symbol/member/extension conformance"
