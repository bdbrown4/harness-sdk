  "contracts": [
    "independent factory-created agents and explicit ownership",
    "bounded per-context serialization and LRU eviction excluding active or paused contexts",
    "metadata-only discovery without representative-agent allocation",
    "synchronous and nonblocking message/send; live message/stream",
    "tasks/get, cooperative active and paused tasks/cancel, and active tasks/resubscribe",
    "atomic initial snapshot and stream cursor; bounded replay and listeners",
    "native human questions and original-task structured answer correlation",
    "accepted sibling effects retained without replay during native abort",
    "durable projection before in-memory abort commit; failed-save retry and primary cleanup preservation",
    "MIME negotiation before admission and artifact enforcement",
    "real native HttpClientHandler over TCP-loopback without URLACL/admin",
    "original TypeScript Task-part versus stream-chunk text semantics"
  ],
  "remaining": [
    "pluggable persistent task stores and restart reattachment",
    "complete configurable cards/skills and authenticated extended-card hosting",
    "standalone/framework HTTP host adapters",
    "endpoint-restricted vended A2A client tools",
    "remote graph-node durable interrupt and snapshot integration",
    "gRPC, REST/HTTP+JSON and push-delivery lifecycle",
    "full upstream symbol/member/extension conformance"
  ],
