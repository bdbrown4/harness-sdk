<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>Strands.Agents.Sqlite</PackageId>
    <Description>SQLite FTS5 BM25 search strategy for Strands byte storage.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CompilerTypeForwarders.cs" Link="CompilerTypeForwarders.cs" />
    <InternalsVisibleTo Include="Strands.Sqlite.Tests" />
    <ProjectReference Include="../Strands.Agents/Strands.Agents.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE.APACHE" Pack="true" PackagePath="/" />
    <None Include="UnicodeLicenseV3.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Include="../../CompilerCompatibility.cs" Link="CompilerCompatibility.cs" />
  </ItemGroup>
</Project>
