                    Check(!headers.ContainsKey("Transfer-Encoding"), "Fixture expected a bounded content-length request.");
                    var bodyLength = headers.TryGetValue("Content-Length", out var length) ? int.Parse(length, CultureInfo.InvariantCulture) : 0; Check(bodyLength >= 0 && bodyLength <= 65536, "Fixture payload exceeded its small bound."); var body = new byte[bodyLength];
                    for (var offset = 0; offset < body.Length;) { var read = await stream.ReadAsync(body, offset, body.Length - offset, _stop.Token).ConfigureAwait(false); if (read == 0) throw new EndOfStreamException(); offset += read; }
                    if (headers.TryGetValue("Content-Encoding", out var encoding) && encoding.IndexOf("aws-chunked", StringComparison.OrdinalIgnoreCase) >= 0) body = DecodeAwsChunks(body);
                    var uri = new Uri(Url + first[1]); var path = Uri.UnescapeDataString(uri.AbsolutePath); Check(path.StartsWith("/fixture-bucket", StringComparison.Ordinal), "Unexpected fixture bucket.");
                    var key = path.Length > 16 ? path.Substring(16).TrimStart('/') : ""; var query = new Dictionary<string, string>(StringComparer.Ordinal);
                    foreach (var part in uri.Query.TrimStart('?').Split('&')) { var equal = part.IndexOf('='); if (equal > 0) query[Uri.UnescapeDataString(part.Substring(0, equal))] = Uri.UnescapeDataString(part.Substring(equal + 1).Replace("+", " ")); }
                    Requests++;
                    var status = 200; var kind = "application/octet-stream"; byte[] response;
                    if (first[0] == "PUT") { Put = true; _objects[key] = body; response = Array.Empty<byte>(); }
                    else if (first[0] == "DELETE") { Delete = true; _objects.Remove(key); status = 204; response = Array.Empty<byte>(); }
                    else if (query.ContainsKey("list-type"))
                    {
                        List = true; Check(query["list-type"] == "2" && query["max-keys"] == "1000", "Unexpected list protocol."); var prefix = query.TryGetValue("prefix", out var value) ? value : "";
                        var objects = string.Concat(_objects.Keys.Where(item => item.StartsWith(prefix, StringComparison.Ordinal)).OrderBy(item => item, StringComparer.Ordinal).Select(item => "<Contents><Key>" + SecurityElement.Escape(item) + "</Key><Size>" + _objects[item].Length.ToString(CultureInfo.InvariantCulture) + "</Size></Contents>"));
                        response = Encoding.UTF8.GetBytes("<ListBucketResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Name>fixture-bucket</Name><IsTruncated>false</IsTruncated>" + objects + "</ListBucketResult>"); kind = "application/xml";
                    }
                    else
                    {
                        Get = true;
                        if (!_objects.TryGetValue(key, out response!)) { status = 404; response = Encoding.UTF8.GetBytes("<Error><Code>NoSuchKey</Code><Message>fixture missing</Message><RequestId>fixture</RequestId></Error>"); kind = "application/xml"; }
                    }
                    await SendAsync(stream, Encoding.ASCII.GetBytes("HTTP/1.1 " + status.ToString(CultureInfo.InvariantCulture) + " Fixture\r\nConnection: close\r\nx-amz-request-id: fixture\r\nContent-Type: " + kind + "\r\nContent-Length: " + response.Length.ToString(CultureInfo.InvariantCulture) + "\r\n\r\n")).ConfigureAwait(false);
                    await SendAsync(stream, response).ConfigureAwait(false);
                }
            }
            catch (SocketException) when (_stop.IsCancellationRequested) { }
            catch (ObjectDisposedException) when (_stop.IsCancellationRequested) { }
        }
        private async Task<string> HeaderAsync(Stream stream)
        {
            using var buffer = new MemoryStream(); var next = new byte[1];
            while (buffer.Length < 65536)
            {
                if (await stream.ReadAsync(next, 0, 1, _stop.Token).ConfigureAwait(false) == 0) throw new EndOfStreamException(); buffer.WriteByte(next[0]); var bytes = buffer.GetBuffer(); var length = (int)buffer.Length;
                if (length >= 4 && bytes[length - 4] == 13 && bytes[length - 3] == 10 && bytes[length - 2] == 13 && bytes[length - 1] == 10) return Encoding.ASCII.GetString(bytes, 0, length - 4);
            }
            throw new InvalidDataException("Fixture headers exceeded the small bound.");
        }
        private static byte[] DecodeAwsChunks(byte[] input)
        {
            using var output = new MemoryStream(); var offset = 0;
            while (offset < input.Length)
            {
                var end = offset; while (end + 1 < input.Length && !(input[end] == 13 && input[end + 1] == 10)) end++;
                Check(end + 1 < input.Length, "Incomplete SDK aws-chunked header."); var size = int.Parse(Encoding.ASCII.GetString(input, offset, end - offset).Split(';')[0], NumberStyles.HexNumber, CultureInfo.InvariantCulture); offset = end + 2;
                if (size == 0) return output.ToArray(); Check(size >= 0 && size <= input.Length - offset - 2, "Invalid SDK aws-chunked length."); output.Write(input, offset, size); offset += size; Check(input[offset] == 13 && input[offset + 1] == 10, "Invalid SDK chunk terminator."); offset += 2;
            }
            throw new InvalidDataException("SDK aws-chunked payload was incomplete.");
        }
        private Task SendAsync(Stream stream, byte[] bytes) => stream.WriteAsync(bytes, 0, bytes.Length, _stop.Token);
        public void Dispose() { _stop.Cancel(); _listener.Stop(); try { _loop.GetAwaiter().GetResult(); } finally { _stop.Dispose(); } }
    }
}
