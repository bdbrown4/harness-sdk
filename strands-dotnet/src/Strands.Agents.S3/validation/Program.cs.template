internal static class Program
{
    private static void Check(bool value, string message) { if (!value) throw new InvalidOperationException(message); }
    private static async Task Main(string[] args)
    {
        Check(args.Length == 1 && IntPtr.Size == int.Parse(args[0], CultureInfo.InvariantCulture), "Physical pointer assertion failed.");
        using var fixture = new LocalS3();
        using var client = new AmazonS3Client(new BasicAWSCredentials("fixture-access", "fixture-secret"), new AmazonS3Config { ServiceURL = fixture.Url, ForcePathStyle = true, AuthenticationRegion = "us-east-1", MaxErrorRetry = 0, Timeout = TimeSpan.FromSeconds(15) });
        var configuration = client.Config;
        var storage = new S3Storage(client, "fixture-bucket", new S3StorageOptions { Prefix = "/root///" });
        var payload = new byte[] { 0, 255, 13, 10, 128, 240, 159, 152, 128 };
        try
        {
            var scoped = storage.Namespace("scope"); var input = (byte[])payload.Clone();
            await scoped.WriteAsync("entries/雪 +%", input); input[0] = 9; await scoped.WriteAsync("empty", Array.Empty<byte>());
            var read = (await scoped.ReadAsync("entries/雪 +%"))!; Check(read.SequenceEqual(payload), "Native byte round trip failed."); read[0] = 7;
            Check((await scoped.ReadAsync("entries/雪 +%"))!.SequenceEqual(payload), "Read buffers were retained."); Check((await scoped.ReadAsync("empty"))!.Length == 0, "Empty byte object was lost.");
            Check((await scoped.ListAsync()).SequenceEqual(new[] { "empty", "entries/雪 +%" }), "Native namespace/list failed.");
            Check((await scoped.SearchAsync("entries")).Single().Key == "entries/雪 +%", "Native keyword search failed.");
            await scoped.DeleteAsync("entries/雪 +%"); await scoped.DeleteAsync("empty"); await scoped.DeleteAsync("missing");
            Check(await scoped.ReadAsync("entries/雪 +%") is null, "NoSuchKey did not represent a missing object."); Check((await scoped.ListAsync()).Count == 0, "Deletes left listed objects.");
        }
        finally { await storage.DisposeAsync(); }
        Check(ReferenceEquals(configuration, client.Config), "Borrowed configuration changed.");
        var available = await client.ListObjectsV2Async(new ListObjectsV2Request { BucketName = "fixture-bucket", Prefix = "root/", MaxKeys = 1000 });
        Check((available.S3Objects?.Count ?? 0) == 0, "Borrowed client was unusable after storage disposal.");
        Check(fixture.Requests >= 15 && fixture.Put && fixture.Get && fixture.Delete && fixture.List, "Expected official SDK protocol operations were absent.");
        Console.WriteLine("S3 package: fourOps=ok; namespace=ok; search=ok; borrowed=true; pointer=" + IntPtr.Size.ToString(CultureInfo.InvariantCulture));
    }

    // This private bounded localhost fixture is not an AWS service emulator or live cloud proof.
    private sealed class LocalS3 : IDisposable
    {
        private readonly TcpListener _listener = new(IPAddress.Loopback, 0);
        private readonly CancellationTokenSource _stop = new(TimeSpan.FromSeconds(45));
        private readonly Dictionary<string, byte[]> _objects = new(StringComparer.Ordinal);
        private readonly Task _loop;
        internal string Url { get; }
        internal int Requests { get; private set; }
        internal bool Put { get; private set; }
        internal bool Get { get; private set; }
        internal bool Delete { get; private set; }
        internal bool List { get; private set; }
        internal LocalS3() { _listener.Start(); Url = "http://127.0.0.1:" + ((IPEndPoint)_listener.LocalEndpoint).Port.ToString(CultureInfo.InvariantCulture); _loop = ServeAsync(); }
        private async Task ServeAsync()
        {
            using var registration = _stop.Token.Register(_listener.Stop);
            try
            {
                while (true)
                {
                    using var connection = await _listener.AcceptTcpClientAsync().ConfigureAwait(false); using var stream = connection.GetStream();
                    var header = await HeaderAsync(stream).ConfigureAwait(false); var lines = header.Split(new[] { "\r\n" }, StringSplitOptions.None); var first = lines[0].Split(' ');
                    var headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                    foreach (var line in lines.Skip(1)) { var colon = line.IndexOf(':'); if (colon > 0) headers[line.Substring(0, colon)] = line.Substring(colon + 1).Trim(); }
                    Check(headers.TryGetValue("Authorization", out var authorization) && authorization.StartsWith("AWS4-HMAC-SHA256 ", StringComparison.Ordinal), "Request was not serialized/signed by the official SDK.");
