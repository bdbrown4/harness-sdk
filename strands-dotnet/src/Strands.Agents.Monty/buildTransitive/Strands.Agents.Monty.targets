<Project>
  <!-- A worker is an executable rather than a native library. Preserve its RID
       directory for portable applications and Framework, including shadowcopy. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../runtimes/**/*">
      <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>runtimes/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
